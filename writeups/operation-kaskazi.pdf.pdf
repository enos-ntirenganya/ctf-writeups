%PreformattedPara
.105882 .121569 .164706 rg
BT 1 0 0 1 0 199.4 Tm /F3 7.4 Tf 9.4 TL (def rc4\(key, data\):) Tj T* (    S, j = list\(range\(256\)\), 0) Tj T* (    for i in range\(256\):) Tj T* (        j = \(j + S[i] + key[i % len\(key\)]\) & 255) Tj T* (        S[i], S[j] = S[j], S[i]) Tj T* (    i = j = 0) Tj T* (    out = bytearray\(\)) Tj T* (    for c in data:) Tj T* (        i = \(i + 1\) & 255) Tj T* (        j = \(j + S[i]\) & 255) Tj T* (        S[i], S[j] = S[j], S[i]) Tj T* (        out.append\(c ^ S[\(S[i] + S[j]\) & 255]\)) Tj T* (    return bytes\(out\)) Tj T*  T* (d   = open\("artifacts/msupdate", "rb"\).read\(\)) Tj T* (a   = d[0x3010:0x3020]                 # .data  @ vaddr 0x4010) Tj T* (b   = d[0x3020:0x3030]                 # .data  @ vaddr 0x4020) Tj T* (key = bytes\(x ^ y for x, y in zip\(a, b\)\)) Tj T* (blob = d[0x2040:0x2040 + 0x98]         # .rodata @ 0x2040, 0x98 bytes) Tj T* (print\(f"[+] rc4 key  = {key.hex\(\)}  \({key!r}\)"\)) Tj T* (print\(f"[+] blob len = {len\(blob\)} bytes\\n"\)) Tj T* (print\(rc4\(key, blob\).decode\(\)\)) Tj T* ET
