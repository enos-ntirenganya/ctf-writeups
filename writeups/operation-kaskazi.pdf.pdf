BT 1 0 0 1 0 133.6 Tm /F3 7.4 Tf 9.4 TL (import struct, sys) Tj T* (from rc4lib import rc4) Tj T*  T* (SESSION_KEY = bytes.fromhex\("a1b2c3d4e5f60718293a4b5c6d7e8f90"\)   # from msupdate config) Tj T* (data, off, n = open\(sys.argv[1], "rb"\).read\(\), 24, 0) Tj T* (while off < len\(data\):) Tj T* (    _, _, caplen, _ = struct.unpack\("<IIII", data[off:off + 16]\); off += 16) Tj T* (    pkt = data[off:off + caplen]; off += caplen; n += 1) Tj T* (    ip  = pkt[14:]; ihl = \(ip[0] & 15\) * 4) Tj T* (    tcp = ip[ihl:]; payload = tcp[\(tcp[12] >> 4\) * 4:]) Tj T* (    if not payload:) Tj T* (        continue) Tj T* (    src = ".".join\(map\(str, ip[12:16]\)\); dst = ".".join\(map\(str, ip[16:20]\)\)) Tj T* (    print\(f"[#{n:02d}] {src} -> {dst}  {len\(payload\):>3}B"\)) Tj T* (    print\("      ", rc4\(SESSION_KEY, payload\).decode\(\)\)     # fresh keystream per message) Tj T* ET
